# ── Postgres ──────────────────────────────────────
POSTGRES_USER=cybersec
POSTGRES_PASSWORD=cybersec
POSTGRES_DB=cybersec
POSTGRES_PORT=5433

# ── Redis ─────────────────────────────────────────
REDIS_PORT=6379

# ── pgAdmin ───────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@cybersec.io
PGADMIN_DEFAULT_PASSWORD=cybersec
PGADMIN_PORT=5050

# ── Backend ───────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── Sandbox ───────────────────────────────────────
SANDBOX_IMAGE=cybersecurity-ai-advisor-sandbox
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MAX_CLONE_MB=500

# ── Embeddings (ADR-0005) ─────────────────────────
